-- Q10
-- Perform a data-quality analysis on customer information.
-- Find records where at least one of the following is true:
-- 1. CustomerName contains unnecessary spaces.
-- 2. Email does not appear to have a valid domain.
-- 3. PhoneNumber contains formatting characters.
-- 4. CustomerName is unusually short.
--
-- Display CustomerID, CustomerName, Email, PhoneNumber,
-- and a DataQualityIssue column describing the problem.

SELECT
    CustomerID,
    CustomerName,
    Email,
    PhoneNumber,

    CONCAT(
        CASE
            WHEN CustomerName <> LTRIM(RTRIM(CustomerName))
              OR CustomerName LIKE '%  %'
            THEN 'Unnecessary spaces; '
            ELSE ''
        END,

        CASE
            WHEN Email IS NULL
              OR Email NOT LIKE '%_@_%._%'
            THEN 'Invalid email domain; '
            ELSE ''
        END,

        CASE
            WHEN PhoneNumber LIKE '%-%'
              OR PhoneNumber LIKE '% %'
              OR PhoneNumber LIKE '%(%'
              OR PhoneNumber LIKE '%)%'
              OR PhoneNumber LIKE '%+%'
            THEN 'Phone formatting characters; '
            ELSE ''
        END,

        CASE
            WHEN LEN(LTRIM(RTRIM(CustomerName))) < 3
            THEN 'Customer name too short; '
            ELSE ''
        END
    ) AS DataQualityIssue

FROM Customers

WHERE
       CustomerName <> LTRIM(RTRIM(CustomerName))
    OR CustomerName LIKE '%  %'
    OR Email IS NULL
    OR Email NOT LIKE '%_@_%._%'
    OR PhoneNumber LIKE '%-%'
    OR PhoneNumber LIKE '% %'
    OR PhoneNumber LIKE '%(%'
    OR PhoneNumber LIKE '%)%'
    OR PhoneNumber LIKE '%+%'
    OR LEN(LTRIM(RTRIM(CustomerName))) < 3;
