-- Q4. For each customer, calculate:
-- total orders, total amount spent,
-- number of orders above 5,000,
-- and average order amount.
-- Show customers who placed at least 3 orders
-- and spent more than 20,000 in total.

SELECT Customerid ,CustomerName, COUNT(DISTINCT order_id) AS Total_orders, SUM(Price * Quatity) AS Total_spent,
SUM(CASE WHEN (Price * Quantity) > 5000 THEN 1 ELSE 0 END) AS Above_5000 , AVG(Price * Quantity) AS Average_amount
FROM Orders 
GROUP BY Customer_id,CustomerName HAVING COUNT(DISTINCT order_id)>=3 AND SUM(Price * Quantity) > 20000;

-- Q5. For each department, find:
-- total employees, total salary,
-- high earners (salary >= 70,000),
-- low earners (salary < 40,000),
-- and average salary.
-- Show departments where high earners are at least 2.

SELECT Department, COUNT(*) AS total_emp, SUM(Salary) AS total_Salary,
SUM(CASE WHEN Salary >= 70000 THEN 1 ELSE 0 END) AS high_earners,
SUM(CASE WHEN Salary < 40000 THEN 1 ELSE 0 END) AS low_earners,
AVG(Salary) AS Average_salary FROM Employees
GROUP BY Department HAVING SUM(CASE WHEN Salary >= 70000 THEN 1 ELSE 0 END) >= 2;

-- Q6. For each order status, calculate:
-- total orders, total revenue,
-- average order amount,
-- orders above 5,000,
-- and percentage of orders belonging to that status.
-- Sort by total revenue from highest to lowest.

SELECT orderstatus,COUNT(DISTINCT orderid) AS Total_orders,
SUM(Price * Quantity) AS Total_Revenue, AVG(Price * Quantity) AS Average_amount,
SUM(CASE WHEN (Price * Quantity) > 5000 THEN 1 ELSE 0 END) AS Above_5000,
COUNT(DISTINCT orderid) / (SELECT COUNT(DISTINCT orderid) FROM orders2) * 100 AS Percentage
FROM orders2 GROUP BY orderstatus ORDER BY Total_Revenue DESC ;

-- Q7. For each city, calculate:
-- total customers,
-- customers with an email,
-- customers without an email,
-- customers with a phone number,
-- and percentage of customers having both email and phone.


SELECT City,COUNT(*) AS Total_customer, SUM(CASE WHEN Email IS NULL THEN 0 ELSE 1 END) AS With_mail,
SUM(CASE WHEN Email IS NULL THEN 1 ELSE 0 END) AS Without_mail, SUM(CASE WHEN Phone IS NULL THEN 0 ELSE 1 END) AS With_phone,
SUM(CASE WHEN Phone IS NULL AND Email IS NULL THEN 0 ELSE 1 END) / (SELECT COUNT(*) FROM Customer)*100 AS Percentage
GROUP BY City;



