-- Q1. Find each department's total employees, average salary,
-- number of employees earning above 50,000,
-- and number of employees earning below 30,000.
-- Show only departments having more than 3 employees.

SELECT Department, COUNT(*) AS Total_emp, SUM(CASE WHEN Salary > 50000 THEN 1 ELSE 0 END) AS Above_50000,
SUM(CASE WHEN Salary < 30000 THEN 1 ELSE 0 END) AS Below_30000 FROM Employees
GROUP BY Department HAVING Total_emp > 3;

-- Q2. Find each city's total customers, total orders,
-- total revenue, and average order value.
-- Show only cities where total revenue is greater than 1,00,000
-- and the average order value is greater than 2,000.

 SELECT City,COUNT(DISTINCT Customer_id) AS Total_customers , COUNT(DISTINCT Order_id) AS Total_orders,
 SUM(Price*Quantity) AS Total_revenue, AVG(Price*Quantity) AS Average_value FROM Orders
 GROUP BY City HAVING Total_revenue > 100000 AND Average_value > 2000;

-- Q3. For each product category, calculate:
-- total products, total quantity, average price,
-- number of products priced above 1,000,
-- and total inventory value (price × quantity).
-- Show categories where total inventory value is greater than 1,00,000.


SELECT Category, COUNT(DISTINCT ProductName) AS Total_product,
SUM(Quantity) AS Total_quantity, AVG(Price * Quantity) AS Average_price,
SUM(CASE WHEN Price > 10000 THEN 1 ELSE 0 END) AS Above_1000,
SUM(Price * Quantity) AS  total_inventotry FROM Orders
GROUP BY Category HAVING SUM(Price * Quantity) > 100000;
