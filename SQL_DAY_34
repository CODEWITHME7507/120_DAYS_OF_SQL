-- Q1. Display each order along with the customer's name,
-- city, order amount, and order status.
-- Use the Customers and Orders tables.

SELECT Customer10.Firstname,Order10.shippingCity, (Order10.UnitPrice * Order10.Quantity) AS Order_amount,
Order10.Orderstatus FROM Customer10 
INNER JOIN Order10 ON Customer10.CustomerID = Order10.CustomerID;

-- Q2. Find the total revenue generated by each customer.
-- Display customer name, city, number of orders,
-- and total amount spent.
-- Sort by total amount spent from highest to lowest.
 
 
 SELECT Cus.Firstname, Ord.Shippingcity,
 COUNT(Ord.OrderID) AS Number_of_Order, SUM(Ord.OrderAmount * Ord.Quantity) AS Total_spent FROM Customer10 AS Cus
 INNER JOIN Order10 AS Ord ON Cus.CustomerID = Ord.CustomerID
 GROUP BY 
    Cus.CustomerID,
    Cus.FirstName,
    Cus.LastName,
    Ord.ShippingCity
ORDER BY Total_spent DESC;

-- Q3. Find customers who have placed at least 3 orders.
-- Display customer name, city, total number of orders,
-- and total amount spent.
-- Show only customers with 3 or more orders.

SELECT Cus.firstname, Ord.shippingcity, COUNT(Ord.OrderID) AS Total_number_of_orders,
SUM(Ord.UnitPrice * Ord.Orderamount) AS Total_amount_spent FROM Customer10 AS Cus
INNER JOIN Order10 AS Ord ON Cus.CustomerID = Ord.CustomerID 
GROUP BY Cus.CustomerID,
Cus.FirstName,
Ord.ShippingCity
HAVING Total_number_of_orders > 3;

-- Q4. Find the average order amount for each city.
-- Display city, number of customers who placed orders,
-- number of orders, and average order amount.
-- Sort by average order amount from highest to lowest.

SELECT Ord.ShippingCity,ROUND(AVG(Ord.UnitPrice * Ord.Quantity)) AS Average_order_amount,
COUNT(DISTINCT Ord.CustomerID) AS Number_of_placed,  COUNT(DISTINCT Ord.OrderID) AS Number_of_Order 
FROM Order10 AS Ord
INNER JOIN Customer10 AS Cus
GROUP BY Ord.ShippingCity
ORDER BY Average_order_amount DESC;



-- Q5. Find the top 10 customers based on total spending.
-- Display customer ID, customer name, city,
-- total orders, and total amount spent.

SELECT Ord.CustomerId, Cus.FirstName, Ord.ShippingCity, COUNT(Ord.OrderID) AS Total_orders,
SUM(Ord.UnitPrice * Ord.Quantity) AS Total_spent FROM Customer10 AS Cus
INNER JOIN Order10 AS Ord
GROUP BY Ord.CustomerID,
Cus.FirstName,
Ord.ShippingCity
ORDER BY Total_spent DESC LIMIT 10;

-- Q6. Find customers whose total spending is greater
-- than 20,000.
-- Display customer name, city, total orders,
-- total spending, and average order value.

SELECT Cus.firstname, Ord.shippingcity, COUNT(Ord.Orderid) AS total_orders,
SUM(Ord.OrderAmount*Ord.Quantity) AS total_spending, ROUND(AVG(Ord.OrderAmount*Ord.Quantity)) AS Order_value
FROM Order10 AS Ord 
INNER JOIN Customer10 AS Cus 
ON Cus.CustomerID = Ord.CustomerID 
GROUP BY Cus.firstname,
Ord.Shippingcity
HAVING total_spending > 20000;

-- Q7. Find the highest-value order placed by each customer.
-- Display customer name, order ID, product,
-- and highest order amount.
-- If a customer has multiple orders with the same
-- highest amount, all matching orders should be considered.

SELECT C.firstname, O.OrderID, Productname, (O.Orderamount * O.Quantity) AS highestAmount
FROM Customer10 AS C 
INNER JOIN Order10 AS O 
ON C.CustomerID = O.CustomerID 
WHERE (O.Orderamount * O.Quantity) = (SELECT MAX(O2.Orderamount * O2.Quantity) FROM Order10 AS O2 WHERE O2.CustomerID = O.CustomerID);

-- Q8. Compare customer order behavior by city.
-- For each city, calculate:
-- total customers who placed orders,
-- total orders,
-- total revenue,
-- average order value,
-- and number of orders above 5,000.

SELECT O.ShippingCity, COUNT(DISTINCT O.CustomerID), COUNT(O.OrderID) AS total_orders,
SUM(O.Orderamount * O.Quantity) AS total_revenue, AVG(O.Orderamount * O.Quantity) AS Average_value,
SUM(
CASE WHEN O.Orderamount > 5000 THEN 1 ELSE 0 END
) AS Number_order_above FROM Order10 AS O
GROUP BY O.ShippingCity;

-- Q9. Identify high-value customers.
-- A high-value customer is one who:
-- 1. Has placed at least 3 orders
-- 2. Has total spending above 25,000
-- 3. Has an average order value above 4,000
-- Display customer name, city, order count,
-- total spending, and average order value.

SELECT C.firstname, O.Shippingcity, COUNT(O.OrderID) AS total_orders, SUM(O.OrderAmount * O.Quantity) AS total_Spending,
AVG(O.OrderAmount * O.Quantity) AS Average_order FROM Order10 AS O
INNER JOIN Customer10 AS C
ON C.CustomerID = O.CustomerID 
GROUP BY C.firstname,
O.Shippingcity 
HAVING total_orders = 3 AND
total_Spending > 25000 AND
Average_order > 4000;

-- Q10. Find the city with the highest total revenue.
-- Display the city, total customers who placed orders,
-- total orders, total revenue, and average order value.
-- Return only the city/cities having the highest revenue.

SELECT O.ShippingCity, COUNT(DISTINCT O.CustomerID) AS Total_Customers, COUNT(O.OrderID) AS total_orders,
SUM(O.Orderamount * O.Quantity) AS total_revenue, AVG(O.Orderamount * O.Quantity) AS Avg_order_Value FROM Order10 AS O
GROUP BY O.ShippingCity HAVING total_revenue = (SELECT MAX(City_revenue) FROM (SELECT SUM(Orderamount * Quantity) AS City_revenue FROM Order10 GROUP BY ShippingCity ) AS Cityrevenue);
