-- Q8. For each product category, calculate:
-- total quantity sold, average price,
-- total sales value (price × quantity),
-- number of products priced above 1,000,
-- and number of products with quantity below 10.
-- Show only categories where total sales value exceeds 1,00,000.

SELECT Category, SUM(Quantity) AS Total_quantity, 
AVG(Price * Quantity) AS Average_price, SUM(Price * Quantity) AS Total_price,
SUM(CASE WHEN Price > 1000 THEN 1 ELSE 0 END) AS Number_of_above_price1000,
SUM(CASE WHEN Quantity < 10 THEN 1 ELSE 0 END) AS Number_of_below_quantity10
FROM Orders2 
GROUP BY Category HAVING SUM(Price * Quantity) > 100000;

-- Q9. For each department, calculate:
-- total employees, average salary,
-- number of employees earning above 60,000,
-- number earning below 30,000,
-- and percentage of employees earning above 60,000.
-- Show only departments where more than 20% of employees
-- earn above 60,000.

SELECT Department, COUNT(*) AS Total_emp,
AVG(Salary) AS Avg_salary, SUM(CASE WHEN Salary > 60000 THEN 1 ELSE 0 END) AS Above_earners_60000,
SUM(CASE WHEN Salary < 30000 THEN 1 ELSE 0 END ) AS below_earners_30000
FROM Employees
GROUP BY Department HAVING ROUND(SUM(CASE WHEN Salary > 60000 THEN 1 ELSE 0 END)*100.0 / COUNT(*),2) > 20;

