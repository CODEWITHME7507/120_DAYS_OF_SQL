-- Sort by successful revenue from highest to lowest.


SELECT MONTHNAME(Orderdate) as Monthh,
COUNT(*) AS Total_orders,
SUM(CASE WHEN Orderstatus= "Delivered" THEN 1 ELSE O END) AS Successful_orders,
