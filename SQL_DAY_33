-- Q7. For each city, calculate:
-- total customers, customers with email,
-- customers with phone, customers having both,
-- and percentage of customers having both email and phone.
-- Show only cities having at least 10 customers.

SELECT city , COUNT(*) AS Total_customers,
SUM(CASE WHEN Email IS NOT NULL THEN 1 ELSE 0 END) AS With_mail,
