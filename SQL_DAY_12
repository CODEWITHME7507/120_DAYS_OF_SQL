-- ==========================================
-- Day 12 Practice Questions
-- Topic: BETWEEN & NOT BETWEEN Operators
-- ==========================================

-- Q1
-- Display all products whose Price is BETWEEN 500 And 1500.

SELECT * FROM Orders
WHERE Price BETWEEN 500 AND 1500;

-- Q2
-- Display all employees whose Salary is BETWEEN 30000 AND 60000.

SELECT * FROM Employees
WHERE Salary BETWEEN 30000 AND 60000;

-- Q3
-- Display all customers whose Age is BETWEEN 18 AND 25.

SELECT * FROM Customers
WHERE Customer_Age BETWEEN 18 AND 25;

-- Q4
-- Display all orders whose TotalAmount is BETWEEN 1000 AND 5000.

SELECT * , Price + Quantity AS totalamount FROM Orders
WHERE Price + Quantity BETWEEN 1000 AND 5000;

-- Q5
-- Display all Employees whose age are BETWEEN 60 AND 80.

SELECT * FROM Employees 
WHERE Age BETWEEN 60 AND 80;

-- Q6
-- Display all products whose Price is NOT BETWEEN 500 AND 1500.

SELECT * FROM Orders
WHERE Price NOT BETWEEN 500 AND 1500;

-- Q7
-- Display all employees whose Salary is NOT BETWEEN 30000 AND 60000.

SELECT * FROM Employees 
WHERE Salary NOT BETWEEN 30000 AND 60000;

-- Q8
-- Display all customers whose Age is NOT BETWEEN 18 AND 25.

SELECT * FROM Customers
WHERE Customer_Age NOT BETWEEN 18 AND 25;

-- Q9
-- Display all orders whose TotalAmount is NOT BETWEEN 1000 AND 5000.

SELECT * FROM Orders
WHERE Price * Quantity NOT BETWEEN 1000 AND 5000;

-- Q10
-- Display all employees whose Salary is BETWEEN 40000 AND 70000
-- AND Department is IN ('Sales', 'Marketing').

SELECT * FROM Employees 
WHERE Salary BETWEEN 40000 AND 70000 AND Department  IN ('Sales', 'Marketing');